rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Config: readable & writable (no Firebase Auth — admin verified client-side) ──
    match /config/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Alumnos: readable & writable by admin (verified client-side) ──
    match /alumnos/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Bitácoras: public create with schema validation; only admin deletes ──
    match /bitacoras/{docId} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['patient','diagnosis','procedure','attendants','createdAt'])
                    && request.resource.data.patient is string
                    && request.resource.data.patient.size() <= 200
                    && request.resource.data.diagnosis is string
                    && request.resource.data.diagnosis.size() <= 500
                    && request.resource.data.procedure is string
                    && request.resource.data.procedure.size() <= 2000
                    && request.resource.data.attendants is list
                    && request.resource.data.attendants.size() <= 20
                    && request.resource.data.createdAt is string;
      allow delete: if true;
      allow update: if false;
    }

    // ── Access logs: create with schema validation; readable for security tab ──
    match /access_logs/{docId} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['ip','ts','ua'])
                    && request.resource.data.ip is string
                    && request.resource.data.ip.size() <= 100
                    && request.resource.data.ua is string
                    && request.resource.data.ua.size() <= 100
                    && request.resource.data.ts is string;
      allow update, delete: if false;
    }

    // ── Blocked IPs: read to check block status; write for admin block/unblock ──
    match /blocked_ips/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Deny all other collections ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
