rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de validación ────────────────────────────────────
    // Campo string opcional con tamaño máximo
    function optStr(d, f, max) {
      return !(f in d) || (d[f] is string && d[f].size() <= max);
    }
    // Campo bool opcional
    function optBool(d, f) {
      return !(f in d) || d[f] is bool;
    }
    // Hash SHA-256 en hex (64 caracteres) — opcional
    function optHash(d, f) {
      return !(f in d) || (d[f] is string && d[f].matches('^[a-f0-9]{64}$'));
    }

    // ── Alumnos ──────────────────────────────────────────────────
    // Permisos permisivos: cualquiera puede leer/crear/editar/eliminar
    // (el control de roles está en la aplicación)
    match /alumnos/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── Config (contraseñas de admin, rangos, inventario) ────────
    // Permisos permisivos para todas las colecciones de config
    match /config/{document=**} {
      allow read, create, update, delete: if true;
    }

    // ── Bitácoras ────────────────────────────────────────────────
    // Permisos permisivos: cualquiera puede crear/editar/eliminar (el control está en la app)
    match /bitacoras/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── Logs de acceso: crear con forma válida; inmutables ───────
    match /access_logs/{docId} {
      allow read: if true;
      allow create: if
        optStr(request.resource.data, 'ip', 80) &&
        optStr(request.resource.data, 'ts', 40) &&
        optStr(request.resource.data, 'ua', 60);
      allow update: if false;
      allow delete: if true;  // el panel de seguridad permite limpiar logs
    }

    // ── IPs bloqueadas ───────────────────────────────────────────
    match /blocked_ips/{docId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.ip is string &&
        request.resource.data.ip.size() <= 80 &&
        optStr(request.resource.data, 'blockedAt', 40);
      allow delete: if true;
    }

    // ── Todo lo demás: denegado ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
