rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de validación ────────────────────────────────────
    // Campo string opcional con tamaño máximo
    function optStr(d, f, max) {
      return !(f in d) || (d[f] is string && d[f].size() <= max);
    }
    // Campo bool opcional
    function optBool(d, f) {
      return !(f in d) || d[f] is bool;
    }
    // Hash SHA-256 en hex (64 caracteres) — opcional
    function optHash(d, f) {
      return !(f in d) || (d[f] is string && d[f].matches('^[a-f0-9]{64}$'));
    }

    // ── Alumnos ──────────────────────────────────────────────────
    // Lectura libre; escritura solo con la forma esperada y tamaños acotados.
    match /alumnos/{docId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        optStr(request.resource.data, 'currentRank', 40) &&
        optStr(request.resource.data, 'username', 60) &&
        optHash(request.resource.data, 'studentPasswordHash') &&
        optBool(request.resource.data, 'graduated') &&
        (!('spells' in request.resource.data) || request.resource.data.spells is map) &&
        (!('infractions' in request.resource.data) ||
          (request.resource.data.infractions is list &&
           request.resource.data.infractions.size() <= 200));
      allow delete: if true;
    }

    // ── Config (contraseñas de admin y rangos) ───────────────────
    match /config/admin {
      allow read: if true;
      // Solo hashes SHA-256 válidos; nunca se puede borrar
      allow create, update: if
        optHash(request.resource.data, 'passwordHash') &&
        optHash(request.resource.data, 'superPasswordHash');
      allow delete: if false;
    }
    match /config/ranks {
      allow read: if true;
      allow create, update: if
        request.resource.data.order is list &&
        request.resource.data.order.size() >= 1 &&
        request.resource.data.order.size() <= 30 &&
        request.resource.data.spells is map;
      allow delete: if false;
    }
    // Cualquier otro doc de config: solo lectura
    match /config/{other} {
      allow read: if true;
      allow write: if false;
    }

    // ── Bitácoras ────────────────────────────────────────────────
    match /bitacoras/{docId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.patient is string &&
        request.resource.data.patient.size() > 0 &&
        request.resource.data.patient.size() <= 80 &&
        request.resource.data.diagnosis is string &&
        request.resource.data.diagnosis.size() > 0 &&
        request.resource.data.diagnosis.size() <= 200 &&
        request.resource.data.procedure is string &&
        request.resource.data.procedure.size() > 0 &&
        request.resource.data.procedure.size() <= 5000 &&
        request.resource.data.attendants is list &&
        request.resource.data.attendants.size() >= 1 &&
        request.resource.data.attendants.size() <= 40 &&
        optStr(request.resource.data, 'createdAt', 40);
      allow delete: if true;
    }

    // ── Logs de acceso: crear con forma válida; inmutables ───────
    match /access_logs/{docId} {
      allow read: if true;
      allow create: if
        optStr(request.resource.data, 'ip', 80) &&
        optStr(request.resource.data, 'ts', 40) &&
        optStr(request.resource.data, 'ua', 60);
      allow update: if false;
      allow delete: if true;  // el panel de seguridad permite limpiar logs
    }

    // ── IPs bloqueadas ───────────────────────────────────────────
    match /blocked_ips/{docId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.ip is string &&
        request.resource.data.ip.size() <= 80 &&
        optStr(request.resource.data, 'blockedAt', 40);
      allow delete: if true;
    }

    // ── Todo lo demás: denegado ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
